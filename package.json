{
  "name": "@aacs111/pi-studio",
  "version": "0.8.6",
  "description": "Web UI for the pi coding agent",
  "homepage": "https://github.com/AACS111/pi-studio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AACS111/pi-studio.git"
  },
  "bugs": {
    "url": "https://github.com/AACS111/pi-studio/issues"
  },
  "license": "MIT",
  "author": "agegr",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "pi-studio": "bin/pi-studio.js"
  },
  "main": "electron/main.cjs",
  "files": [
    "bin",
    ".next",
    "!.next/cache",
    "!.next/dev",
    "!.next/**/*.js.map",
    "public",
    "next.config.mjs",
    "package.json"
  ],
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 10141",
    "dev:electron": "node scripts/dev-electron.mjs",
    "dev:lan": "next dev -H 0.0.0.0 -p 30141",
    "build": "next build --webpack",
    "start": "next start -H 127.0.0.1 -p 30141",
    "start:lan": "next start -H 0.0.0.0 -p 30141",
    "pack": "node scripts/package.mjs",
    "pack:dir": "node scripts/package.mjs --dir",
    "pack:portable": "node scripts/package.mjs --portable",
    "pack:nsis": "node scripts/package.mjs --nsis",
    "pack:msi": "node scripts/package.mjs --msi",
    "lint": "eslint .",
    "release": "npm version patch --no-git-tag-version && npm run build && npm publish --access public"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@univerjs/presets": "^0.25.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "fflate": "^0.8.3",
    "next": "16.2.12",
    "proper-lockfile": "4.1.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typebox": "1.3.7",
    "undici": "8.5.0",
    "univer-cli": "^0.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@lobehub/icons": "^5.6.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^25",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jiti": "^2.7.0",
    "katex": "^0.16.47",
    "mammoth": "^1.12.0",
    "mermaid": "^11.14.0",
    "postcss": "^8",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5"
  }
}
