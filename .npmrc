# npm 包走国内镜像（npmmirror 与 registry.npmjs.org 内容一致，lockfile 完整性哈希不受影响），
# 否则直连官方源在本网络下 npm i 要 8 分钟+
registry=https://registry.npmmirror.com/

# 国内镜像（与 scripts/package.mjs 的默认值一致）。
# npm 会把 electron_mirror 转成 npm_config_electron_mirror，供 @electron/get
# 在 electron postinstall 下载二进制时读取（mirrorVar 的 .npmrc 分支）。
electron_mirror=https://npmmirror.com/mirrors/electron/
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/
