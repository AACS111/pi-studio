# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/.repro-dist/

# production
/build/*
!/build/icon.ico

# desktop packaging (electron-builder)
/release/
/.next-pkg/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.factory

# pi-web runtime data (configurable; default location)
/pi-web-uploads/
.pi-web-config.json

# 临时诊断脚本（trace-*）与输出，不入库
scripts/trace-hook.cjs
scripts/trace-requires.cjs
trace-result.txt
# browser-use sidecar (Python venv + logs)
tools/browser-use-server/.venv/
tools/browser-use-server/.browser-profile/
tools/browser-use-server/__pycache__/
tools/browser-use-server/*.log

# 日志与临时文件
*.log
*.tmp

# 临时调试/测试脚本（根目录与 electron/test-*），不入库
/test-builtin*.js
/test-e*.cjs
electron/test-*.cjs
electron/test-*.js
electron/test-api.js
