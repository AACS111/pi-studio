+/**
+ * [pi-studio context-diet] Decide what can be trimmed from the replayed history:
+ * - lastAssistantIndex: only this assistant message replays its thinking blocks
+ *   (provider-verified: DeepSeek accepts history without reasoning_content).
+ * - fold: index -> one-line placeholder for stale, large tool results.
+ * - dropImages: index -> stale tool results whose base64 screenshots are omitted
+ *   (keeps the last N image results so the model can still see recent ones).
+ * Disable with PI_CONTEXT_DIET=0; tune with PI_KEEP_RECENT_TOOL_RESULTS /
+ * PI_FOLD_TOOL_RESULT_MIN_CHARS / PI_KEEP_RECENT_TOOL_IMAGES, or in the
+ * pi-studio settings panel (settings.json -> contextDiet section, re-read every 5s).
+ */
+const CONTEXT_DIET_DEFAULTS = { enabled: true, keepRecentToolResults: 8, foldMinChars: 2000, keepRecentImages: 3 };
+let contextDietFileCache = { at: 0, value: null };
+/**
+ * [pi-studio] contextDiet section of settings.json, re-read at most every 5s so the
+ * settings panel can retune a running server without a restart. Process env wins.
+ */
+function readContextDietFileSettings() {
+    if (contextDietFileCache.value && Date.now() - contextDietFileCache.at < 5000)
+        return contextDietFileCache.value;
+    const value = { ...CONTEXT_DIET_DEFAULTS };
+    try {
+        const agentDir = process.env.PI_CODING_AGENT_DIR || join(homedir(), ".pi", "agent");
+        const raw = JSON.parse(readFileSync(join(agentDir, "settings.json"), "utf-8"));
+        const section = raw?.contextDiet ?? {};
+        if (typeof section.enabled === "boolean")
+            value.enabled = section.enabled;
+        if (Number.isFinite(section.keepRecentToolResults))
+            value.keepRecentToolResults = Math.max(0, Math.floor(section.keepRecentToolResults));
+        if (Number.isFinite(section.foldMinChars))
+            value.foldMinChars = Math.max(200, Math.floor(section.foldMinChars));
+        if (Number.isFinite(section.keepRecentImages))
+            value.keepRecentImages = Math.max(0, Math.floor(section.keepRecentImages));
+    }
+    catch {
+        // settings.json 缺失/损坏 → 用内置默认值，不能让精简逻辑挡住请求
+    }
+    contextDietFileCache = { at: Date.now(), value };
+    return value;
+}
+function planContextDiet(messages, keepRecentToolResults, foldMinChars, keepRecentImages) {
+    let lastAssistantIndex = -1;
+    for (let i = 0; i < messages.length; i++) {
+        if (messages[i].role === "assistant")
+            lastAssistantIndex = i;
+    }
+    const keep = new Set();
+    for (let i = messages.length - 1; i >= 0 && keep.size < keepRecentToolResults; i--) {
+        if (messages[i].role === "toolResult")
+            keep.add(i);
+    }
+    const fold = new Map();
+    for (let i = 0; i < messages.length; i++) {
+        const msg = messages[i];
+        if (msg.role !== "toolResult" || keep.has(i))
+            continue;
+        const text = (msg.content ?? [])
+            .filter((block) => block.type === "text")
+            .map((block) => block.text ?? "")
+            .join("\n");
+        if (text.length < foldMinChars)
+            continue;
+        const kb = (text.length / 1024).toFixed(1);
+        const lines = text.split("\n").length;
+        fold.set(i, `[folded: ${msg.toolName ?? "tool"} output was ${kb} KB / ${lines} lines - re-run the command if the full output is needed again]`);
+    }
+    const dropImages = new Set();
+    const keepImageIndices = new Set();
+    let keptImages = 0;
+    for (let i = messages.length - 1; i >= 0; i--) {
+        const msg = messages[i];
+        if (msg.role !== "toolResult")
+            continue;
+        const imageCount = (msg.content ?? []).filter((block) => block.type === "image").length;
+        if (imageCount === 0)
+            continue;
+        if (keptImages < keepRecentImages) {
+            keptImages += 1;
+            keepImageIndices.add(i);
+        }
+        else {
+            dropImages.add(i);
+        }
+    }
+    return { lastAssistantIndex, fold, dropImages };
